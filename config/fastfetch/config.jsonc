// TNFX Nord: left-rail sections like the starship prompt. Only width-1 box characters sit before the
// aligned column, so it stays straight whatever width the terminal gives Nerd Font icons.
// The logo is CachyOS's icon, turned into a transparent PNG by install.sh and drawn as an image in kitty;
// without it (other distros/terminals) fastfetch falls back to its text logo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/logo.png",
        "width": 22,
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "",
        "color": { "keys": "white", "output": "white" }
    },
    "modules": [
        { "type": "title", "format": "{#1;36}{user-name}{#0;90} @ {#1;34}{host-name}" },
        { "type": "custom", "format": "{#90}─────────────────────────────" },
        { "type": "custom", "format": "{#36}╭─ {#1;36}system" },
        { "type": "os",       "key": "{#36}│{#37}  distro    ", "format": "{pretty-name}" },
        { "type": "kernel",   "key": "{#36}│{#37}  kernel    " },
        { "type": "uptime",   "key": "{#36}│{#37}  uptime    " },
        { "type": "packages", "key": "{#36}│{#37}  packages  " },
        { "type": "custom", "format": "{#34}├─ {#1;34}desktop" },
        { "type": "de",       "key": "{#34}│{#37}  plasma    ", "format": "{version}" },
        { "type": "wm",       "key": "{#34}│{#37}  wm        " },
        { "type": "terminal", "key": "{#34}│{#37}  terminal  " },
        { "type": "shell",    "key": "{#34}│{#37}  shell     " },
        { "type": "custom", "format": "{#35}├─ {#1;35}hardware" },
        { "type": "cpu",      "key": "{#35}│{#37}  cpu       ", "format": "{name}" },
        { "type": "gpu",      "key": "{#35}│{#37}  gpu       ", "format": "{name}" },
        { "type": "memory",   "key": "{#35}│{#37}  memory    " },
        { "type": "disk",     "key": "{#35}│{#37}  disk      ", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
        { "type": "battery",  "key": "{#35}│{#37}  battery   " },
        { "type": "custom", "format": "{#35}╰─" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
