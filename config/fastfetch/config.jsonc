// TNFX Nord: rounded box matching the starship prompt, based on fastfetch's Catnap-style example (presets/examples/13).
// Colors are ANSI, so they follow kitty's Nord palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "cyan", "2": "blue" },
        "padding": { "top": 2, "left": 2, "right": 3 }
    },
    "display": {
        "separator": " ",
        "color": { "keys": "blue", "output": "white" }
    },
    "modules": [
        { "type": "custom",  "key": "╭───────────╮" },
        { "type": "title",   "key": "│ {#36} user    {#keys}│", "format": "{user-name}{#90}@{#0}{host-name}" },
        { "type": "os",      "key": "│ {#36}{icon} distro  {#keys}│", "format": "{pretty-name}" },
        { "type": "kernel",  "key": "│ {#36} kernel  {#keys}│" },
        { "type": "uptime",  "key": "│ {#36}󰅐 uptime  {#keys}│" },
        { "type": "packages","key": "│ {#36}󰏖 pkgs    {#keys}│" },
        { "type": "custom",  "key": "├───────────┤" },
        { "type": "de",      "key": "│ {#34}󰇄 desktop {#keys}│" },
        { "type": "wm",      "key": "│ {#34} wm      {#keys}│" },
        { "type": "terminal","key": "│ {#34} term    {#keys}│" },
        { "type": "shell",   "key": "│ {#34} shell   {#keys}│" },
        { "type": "custom",  "key": "├───────────┤" },
        { "type": "cpu",     "key": "│ {#35}󰍛 cpu     {#keys}│", "format": "{name}" },
        { "type": "gpu",     "key": "│ {#35}󰾲 gpu     {#keys}│", "format": "{name}" },
        { "type": "memory",  "key": "│ {#35} memory  {#keys}│" },
        { "type": "disk",    "key": "│ {#35}󰉉 disk    {#keys}│", "folders": "/" },
        { "type": "battery", "key": "│ {#35} battery {#keys}│" },
        { "type": "custom",  "key": "├───────────┤" },
        { "type": "colors",  "key": "│ {#37} colors  {#keys}│", "symbol": "circle" },
        { "type": "custom",  "key": "╰───────────╯" }
    ]
}
